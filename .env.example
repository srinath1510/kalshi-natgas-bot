# All settings are optional; defaults shown. No API keys are needed: everything here is public read-only data.
# NATGAS_DB_PATH=data/natgas.db
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_SERIES=KXNATGAS15M,KXGOLD15M,KXWTI15M,KXSILVER15M,KXCOPPER15M,KXPLATINUM15M,KXPALLADIUM15M
# KALSHI_MAX_RPS=15           # evenly spaced cap on Kalshi requests
# HL_INFO_URL=https://api.hyperliquid.xyz/info
# HL_DEXES=xyz                 # comma-separated HIP-3 dex names to scan
# HL_COINS=xyz:NATGAS,xyz:GOLD,xyz:CL,xyz:SILVER,xyz:COPPER,xyz:PLATINUM,xyz:PALLADIUM  # empty = auto-discover *NATGAS*
# ORDERBOOK_INTERVAL_S=1.0
# TRADES_INTERVAL_S=2.0
# TRACKER_INTERVAL_S=5.0
# SETTLEMENT_INTERVAL_S=60
# HL_INTERVAL_S=2.0
# ORDERBOOK_KEEPALIVE_S=15
