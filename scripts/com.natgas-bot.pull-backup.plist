<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent: pull the newest natgas-bot DB backup twice a day (runs on wake if missed).
     Install: scripts/install_pull_backup.sh -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.natgas-bot.pull-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/bin/natgas-pull-backup</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/natgas-pull-backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/natgas-pull-backup.log</string>
</dict>
</plist>
